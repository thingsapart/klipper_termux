<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:colorAccent">@color/mainsail_primary</item>
        <item name="android:navigationBarColor">#0C0C0C</item>
        <item name="android:statusBarColor">#0C0C0C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase" />

    <style name="MainsailSectionTitle">
        <item name="android:textColor">@color/mainsail_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MainsailCardTitle">
        <item name="android:textColor">@color/mainsail_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PanelHeaderStandalone" parent="MainsailCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_panel_header</item>
        <item name="android:padding">13dp</item>
    </style>

    <style name="StatusDot">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">●</item>
        <item name="android:textColor">@color/mainsail_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StatusName">
        <item name="android:textColor">@color/mainsail_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StatusValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/mainsail_text_muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="MainsailDrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/drawer_item_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WizardStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">9dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WizardHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_panel_header</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <style name="WizardHeaderTitle" parent="MainsailCardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="WizardHeaderState">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/mainsail_text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WizardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_panel_body</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="MainsailBodyText">
        <item name="android:textColor">@color/mainsail_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="MainsailButtonBase" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/mainsail_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="MainsailButtonPrimary" parent="MainsailButtonBase">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="MainsailButtonSecondary" parent="MainsailButtonBase">
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="MainsailButtonDanger" parent="MainsailButtonBase">
        <item name="android:background">@drawable/bg_button_danger</item>
    </style>

    <!-- Dependency-free Android 7-9 title typography. -->
    <style name="K4AAppBarTitleWord">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="K4AAppBarTitleSeparator">
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
