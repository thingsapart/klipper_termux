# Auto mode publishes the PTY immediately and selects the first permitted USB
# serial port whenever one is attached. Use a stable UUID here only when pinning
# an alias to one of several printer controllers.
server=127.0.0.1
port=27831
token=TOKEN
log_interval=60
device=main,auto,250000,8,1,none,dtr+rts,@PREFIX@/var/run/klipper-android/main
