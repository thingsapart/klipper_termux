#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
DATA_DIR="@DATA_DIR@"
PREFIX="@PREFIX@"
HOME_DIR="@HOME@"
WEB_PORT="@WEB_PORT@"
SERVICES=(@SERVICES@)

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  COLOR_OK=$'\033[1;32m'
  COLOR_FAIL=$'\033[1;31m'
  COLOR_RESET=$'\033[0m'
else
  COLOR_OK=""
  COLOR_FAIL=""
  COLOR_RESET=""
fi

check() {
  local label="$1" output
  shift
  if output=$("$@" 2>&1); then
    printf '%s[ok]%s   %s\n' "$COLOR_OK" "$COLOR_RESET" "$label"
  else
    printf '%s[FAIL]%s %s\n' "$COLOR_FAIL" "$COLOR_RESET" "$label"
    [[ -n "$output" ]] && printf '       %s\n' "$output"
    failures=$((failures + 1))
  fi
}

service_is_up() {
  local status
  status=$(SVDIR="$PREFIX/var/service" sv status "$1" 2>&1) || true
  if grep -q '^run:' <<<"$status"; then return 0; fi
  printf '%s' "$status"
  return 1
}

case "${1:-status}" in
  start|stop|monitor|enable|disable)
    exec "@HOME@/.local/bin/klipper-android-runner" "$@"
    ;;
  status)
    SVDIR="$PREFIX/var/service" sv status "${SERVICES[@]}" 2>/dev/null || true
    ;;
  doctor)
    failures=0
    check "native bridge executable" test -x "$HOME_DIR/.local/bin/klipper-android-bridge"
    check "bridge configuration exists" test -f "$DATA_DIR/config/bridge.conf"
    if [[ -f "$DATA_DIR/config/bridge.conf" ]]; then
      check "bridge configuration is valid" \
        "$HOME_DIR/.local/bin/klipper-android-bridge" --check-config "$DATA_DIR/config/bridge.conf"
    fi
    check "Klipper Python environment" test -x "$HOME_DIR/klippy-env/bin/python"
    check "Klipper printer configuration" test -f "$DATA_DIR/config/printer.cfg"
    check "runit service directory" test -d "$PREFIX/var/service"
    for service in "${SERVICES[@]}"; do
      check "$service service is running" service_is_up "$service"
    done
    check "bridge PTY is published" test -e "$PREFIX/var/run/klipper-android/main"
    if [[ -d "$PREFIX/var/service/moonraker" ]]; then
      check "Moonraker API on port 7125" \
        curl -fsS --max-time 2 http://127.0.0.1:7125/server/info
    fi
    if [[ -d "$PREFIX/var/service/klipper-web" ]]; then
      check "Mainsail static application" test -f "$HOME_DIR/mainsail/index.html"
      check "Mainsail proxy can reach Moonraker" \
        curl -fsS --max-time 2 "http://127.0.0.1:$WEB_PORT/server/info"
    fi
    if (( failures )); then
      printf '\n%s[FAIL]%s doctor found %d problem(s)\n' \
        "$COLOR_FAIL" "$COLOR_RESET" "$failures"
    else
      printf '\n%s[ok]%s all checks passed\n' "$COLOR_OK" "$COLOR_RESET"
    fi
    exit "$failures"
    ;;
  logs)
    service="${2:-klipper}"
    log_files=()
    [[ -f "$DATA_DIR/logs/${service}.log" ]] && log_files+=("$DATA_DIR/logs/${service}.log")
    [[ -f "$DATA_DIR/logs/$service/current" ]] && log_files+=("$DATA_DIR/logs/$service/current")
    if ((${#log_files[@]} == 0)); then
      log_files+=("$DATA_DIR/logs/$service/current")
    fi
    exec tail -n 100 -F "${log_files[@]}"
    ;;
  restart)
    shift
    if (($#)); then exec sv restart "$@"; else exec sv restart "${SERVICES[@]}"; fi
    ;;
  *) echo "Usage: kabctl {start|stop|status|monitor|enable|disable|doctor|logs [service]|restart [services...]}" >&2; exit 2 ;;
esac
